	<flow name="error-notification-flow" doc:id="4d5c948d-748e-4ce8-824b-b020116fb84d" >
		<ee:transform doc:name="Notification Request" doc:id="1c78db6b-e3e8-46e7-ae14-f96fbd9eb5b2" >
			<ee:message >
				<ee:set-payload resource="dw\notificationRequest.dwl" />
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Notification Request Logger" doc:id="cdd6c459-35bd-4f2b-a67b-7178c6b13091" message="Error Notification Request logger" category="error-notification-flow" />
		<until-successful maxRetries="${notification.retryCount}" doc:name="Until Successful" doc:id="7e4f1f8b-3cd8-4b39-b719-06085711a7d2" millisBetweenRetries="${notification.retryInterval}" >
			<http:request method="POST" doc:name="Send Notification" doc:id="051bcfd6-503d-48f9-9692-bea6d45566fd" config-ref="httpRequester-notification-api" path="${notification.path}" sendCorrelationId="ALWAYS" correlationId="#[correlationId]" >
				<http:headers ><![CDATA[#[output application/java
---
{
	"client_secret" : Mule::p("secure::notification.client_secret"),
	"client_id" : Mule::p("secure::notification.client_id")
}]]]></http:headers>
			</http:request>
		</until-successful>
		<logger level="INFO" doc:name="Notification Response Logger" doc:id="38a948e2-9897-45df-941c-1156a953b897" message="Error Notification Response logger" category="error-notification-flow" />
		<error-handler >
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="9a917ba7-699f-4e31-b690-d8807223d074" type="ANY">
				<logger level="ERROR" doc:name="Notification Exception Logger" doc:id="7b4029a5-e2b5-47ad-9e29-9b603e98f1b8" message="Error while processing in Notification Flow - #[error.description]" category="error-notification-flow"/>
			</on-error-continue>
		</error-handler>
	</flow>
