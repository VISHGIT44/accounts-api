    <flow name="post:\ach-transfers:application\json:apiConfig">
        <logger level="INFO" doc:name="Start Log" doc:id="919a03da-8a80-48c7-97b7-00d74def5408" message="ach-transfer implementation flow started" />
        <set-variable value="#[payload.toAccountNumber]" doc:name="To Account Number" doc:id="21eae76b-a968-4f75-a568-ed8cb791b0d0" variableName="accountNumber" />
        <set-variable value="#[payload.extAcctNbr]" doc:name="From Account Number" doc:id="cb2d4ff1-4f89-411f-8600-e1168daa65dd" variableName="fromAccountNumber" />
        <set-variable value="#[payload]" doc:name="Original Request" doc:id="0956b8c0-6d91-49e8-b065-e11d579cdba8" variableName="originalRequest" />
        <flow-ref doc:name="ach-transfer-funds" doc:id="8ac483d6-4a31-43c0-b0cb-0ded03aa6a44" name="ach-transfer-funds" />
        <logger level="INFO" doc:name="End Log" doc:id="acb470d9-b12e-4095-8794-d43867d13a13" message="ach-transfer implementation flow Ended" />
        <error-handler>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="9405141f-9950-4879-aa84-33cf94a362fa">
                <logger level="ERROR" doc:name="Error Log" doc:id="4bfbfe10-4f41-428c-ae71-da185ac2b4bb" message="ach-transaction failed and moved to retry" />
                <ee:transform doc:name="Form failure reprocessing request" doc:id="5af71ea4-daa8-4b45-bf4a-23671c07b371">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	request: vars.originalRequest,
	errorMessage: error.exception.'type'
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="escapedRequest"><![CDATA[%dw 2.0
output application/json
---
write(vars.originalRequest, "application/json")]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
                <db:insert doc:name="Add failed transaction to DB" doc:id="99e60b20-f6ca-4bc7-8881-8af84507d569" config-ref="CoreDB_Database_Config">
                    <db:sql><![CDATA[INSERT INTO ACHFailedRequests (Account_number, From_account_number, Request, Error_message, Status, 
	Request_date, Last_processed_date) VALUES (:toAccountNumber, :fromAccountNumber, :request, :errorMessage, :status, :requestDate, :lastProcessedDate)]]></db:sql>
                    <db:input-parameters><![CDATA[#[{
	'toAccountNumber': vars.accountNumber,
	'fromAccountNumber': vars.fromAccountNumber,
	'request': write(vars.originalRequest, "application/json"),
	'errorMessage': payload.errorMessage,
	'status': 'Pending',
	'requestDate': now() as String {format: "y-MM-dd"},
	'lastProcessedDate':now() as String {format: "y-MM-dd"}
}]]]></db:input-parameters>
                </db:insert>
            </on-error-propagate>
        </error-handler>
    </flow>
