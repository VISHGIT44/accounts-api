#%RAML 1.0 DataType

type: object
properties:
  requestNumber?: string
  requestTypeCode: integer
  WasSuccessful: boolean
  accountResponse:
    type: object
    properties:
      accountRoleCode?: string
      accountRoleDescription?: string
      effectiveDate?: string
      accountNumber: string
      personNumber?: string
      orgNumber?: string
      inactiveDate?: string
      wasSuccessful: boolean
  errors?: 
    type: array
    items:
      type: !include error.raml
  userAuthentication: !include user-authentication.raml