#%RAML 1.0 DataType

type: object
properties:
  personNumber: integer
  name:
    type: object
    properties:
      firstName: string
      lastName: string
  isCreateMember?: boolean
  memberGroupCode?: string
  isTaxReportedForOwner?: boolean
  isTaxReportedForSigner?: boolean
  isExecuteOwnerLogic?: boolean
  accountRoles?:
    type: array
    items:
      type: !include account-role.raml