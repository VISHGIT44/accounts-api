#%RAML 1.0 DataType

displayName: Create Account Response
description: Create Account Response structure
type: object
properties:
  requestNumber?: integer
  requestTypeCode: integer
  wasSuccessful: boolean
  agreementNumber: number
  orgNumber?: number
  personNumber?: number
  errors?: 
    type: array
    items:
      type: !include error.raml
  userAuthentication: !include user-authentication.raml